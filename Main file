#include <stdio.h>
#include <winsock2.h>
#include <windows.h>
#include <stdlib.h>
#include <string.h>

#pragma comment(lib, "ws2_32.lib")

void wake_my_tv(const char *mac_str) {
    SOCKET s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);

    if (s == INVALID_SOCKET) {
        printf("Wake socket creation failed: %d\n", WSAGetLastError());
        return;
    }

    int broadcast = 1;

    if (setsockopt(
            s,
            SOL_SOCKET,
            SO_BROADCAST,
            (char *)&broadcast,
            sizeof(broadcast)
        ) == SOCKET_ERROR) {

        printf("setsockopt failed: %d\n", WSAGetLastError());
        closesocket(s);
        return;
    }

    // Convert MAC string into 6 raw bytes
    unsigned char mac[6];

    if (sscanf(
            mac_str,
            "%hhx:%hhx:%hhx:%hhx:%hhx:%hhx",
            &mac[0],
            &mac[1],
            &mac[2],
            &mac[3],
            &mac[4],
            &mac[5]
        ) != 6) {

        printf("Invalid MAC address\n");
        closesocket(s);
        return;
    }

    // Magic packet:
    // 6 bytes FF + MAC address repeated 16 times
    unsigned char packet[102];

    memset(packet, 0xFF, 6);

    for (int i = 0; i < 16; i++) {
        memcpy(packet + 6 + i * 6, mac, 6);
    }

    struct sockaddr_in target;
    memset(&target, 0, sizeof(target));

    target.sin_family = AF_INET;
    target.sin_port = htons(9);

    // Broadcast address for your 192.xxx.x.x network
    target.sin_addr.s_addr = inet_addr("192.xxx.x.255");

    // Send for ~90 seconds because the TV may take time
    // to become ready for Wake-on-LAN after shutdown.
    for (int i = 0; i < 360; i++) {
    int sent = sendto(
        s,
        (char *)packet,
        sizeof(packet),
        0,
        (struct sockaddr *)&target,
        sizeof(target)
    );

    if (sent == SOCKET_ERROR) {
        printf("Wake packet %d failed: %d\n",
               i + 1,
               WSAGetLastError());
    } else {
        printf("Wake packet %d sent (%d bytes)\n",
               i + 1,
               sent);
    }

        Sleep(250);
    }

    closesocket(s);
}


int main() {
    WSADATA wsa;

    SOCKET server_fd;
    SOCKET client_fd;

    struct sockaddr_in server;
    struct sockaddr_in client;

    int c;
    int recv_size;

    char buffer[2000];

    // 1. Initialize Winsock
    if (WSAStartup(MAKEWORD(2, 2), &wsa) != 0) {
        printf(
            "Failed to initialize Winsock. Error Code: %d\n",
            WSAGetLastError()
        );

        return 1;
    }

    // 2. Create TCP server socket
    server_fd = socket(AF_INET, SOCK_STREAM, 0);

    if (server_fd == INVALID_SOCKET) {
        printf(
            "Could not create socket. Error Code: %d\n",
            WSAGetLastError()
        );

        WSACleanup();
        return 1;
    }

    // 3. Prepare server address
    memset(&server, 0, sizeof(server));

    server.sin_family = AF_INET;
    server.sin_addr.s_addr = INADDR_ANY;
    server.sin_port = htons(8888);

    // 4. Bind socket to port 8888
    if (bind(
            server_fd,
            (struct sockaddr *)&server,
            sizeof(server)
        ) == SOCKET_ERROR) {

        printf(
            "Bind failed. Error Code: %d\n",
            WSAGetLastError()
        );

        closesocket(server_fd);
        WSACleanup();

        return 1;
    }

    // 5. Listen
    if (listen(server_fd, 3) == SOCKET_ERROR) {
        printf(
            "Listen failed. Error Code: %d\n",
            WSAGetLastError()
        );

        closesocket(server_fd);
        WSACleanup();

        return 1;
    }

    printf(
        "Server started. Waiting for your phone "
        "to connect on port 8888...\n"
    );

    // 6. Accept phone connection
    c = sizeof(client);

    client_fd = accept(
        server_fd,
        (struct sockaddr *)&client,
        &c
    );

    if (client_fd == INVALID_SOCKET) {
        printf(
            "Accept failed. Error Code: %d\n",
            WSAGetLastError()
        );

        closesocket(server_fd);
        WSACleanup();

        return 1;
    }

    printf("Phone connected successfully!\n\n");

    // 7. Receive commands
    while ((recv_size = recv(client_fd ,buffer, sizeof(buffer) - 1, 0)) > 0) {

        buffer[recv_size] = '\0';

        // Remove \r or \n sent by Termux
        buffer[strcspn(buffer, "\r\n")] = '\0';

        printf("Phone says: %s\n", buffer);

        // TURN TV ON
        if (strcmp(buffer, "tv") == 0) {

            printf(
                "Sending Wake-on-LAN packets "
                "to Samsung TV...\n"
            );
        //INSERT YOUR TV MAC ADDRESS
            wake_my_tv("cc:6e:a4:c9:8f:8a");
        }
        else if(strcmp(buffer, "up") == 0){
            printf(
                "Sending volume up command "
                "to Samsung TV...\n"
            );
            system(
                "py \"C:/Users/ronfa/OneDrive/Documents/"
                "C codes/Firstnetwork/vol_up.py\""
            );
        }
        else if(strcmp(buffer, "down") == 0){
            printf(
                "Sending volume up command "
                "to Samsung TV...\n"
            );
            system(
                "py \"C:/Users/ronfa/OneDrive/Documents/"
                "C codes/Firstnetwork/vol_down.py\""
            );
        }
        else if(strcmp(buffer, "mute") == 0){
            printf(
                "Sending mutecommand "
                "to Samsung TV...\n"
            );
            system(
                "py \"C:/Users/ronfa/OneDrive/Documents/"
                "C codes/Firstnetwork/mute.py\""
            );
        }
        // TURN TV OFF
        else if (strcmp(buffer, "off") == 0) {

            printf(
                "Sending shutdown command "
                "to Samsung TV...\n"
            );

            system(
                "py \"C:/Users/ronfa/OneDrive/Documents/"
                "C codes/Firstnetwork/turn_off.py\""
            );
        }

        else {
            printf("Unknown command.\n");
        }
    }

    if (recv_size == 0) {
        printf("Phone disconnected.\n");
    } else {
        printf(
            "recv failed. Error Code: %d\n",
            WSAGetLastError()
        );
    }

    // 8. Cleanup
    closesocket(client_fd);
    closesocket(server_fd);

    WSACleanup();

    return 0;
}
